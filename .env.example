# DashScope API密钥（通义千问）
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=your_qwen_dashscope_api_key


# 数据库配置（支持 PostgreSQL 或 MySQL）
DATABASE_URL=postgresql://user:password@localhost:5432/photostyle
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/photostyle


#用户画像模块，默认召回语义锚点数量
DEFAULT_ANCHOR_TOP_K= 8

#embedding模型配置
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5

# Milvus 向量数据库配置
# 使用独立 milvus-server（推荐）：http://localhost:19530
# 使用 Milvus Lite 嵌入式版本：./milvus_demo.db
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION_NAME=photo_style_embeddings
MILVUS_EMBEDDING_DIM=768
# MILVUS_TOKEN=  # 如果 milvus-server 配置了认证，在这里填写

# RabbitMQ 配置
RABBITMQ_URL=amqp://photostyle:密码@IP:5672/%2F
RABBITMQ_FEEDBACK_QUEUE=photo_style.feedback.updated
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_TIMEOUT=30
RABBITMQ_REVIEW_SUBMITTED_EXCHANGE=review.submitted
RABBITMQ_REVIEW_SUBMITTED_ROUTING_KEY=review.submitted

# LangSmith链路追踪配置
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=photostyle
# LANGCHAIN_API_KEY=

# 调试模式开关（启用后会输出详细日志到控制台）
DEBUG=false

# 日志配置
# LOG_DIR=  # 日志目录，默认为项目根目录下的logs文件夹
LOG_LEVEL=INFO  # 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_KEEP_DAYS=3  # 日志文件保留天数
LOG_MAX_BYTES=10485760  # 单个日志文件最大字节数（默认10MB）