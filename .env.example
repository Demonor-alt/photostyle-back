DASHSCOPE_API_KEY=your_qwen_dashscope_api_key

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=photostyle
MYSQL_POOL_ENABLED=false

# LangSmith链路追踪配置
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=photostyle
# LANGCHAIN_API_KEY=

# 调试模式开关（启用后会输出详细日志到控制台）
DEBUG=false

# 日志配置
# LOG_DIR=  # 日志目录，默认为项目根目录下的logs文件夹
LOG_LEVEL=INFO  # 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_KEEP_DAYS=3  # 日志文件保留天数
LOG_MAX_BYTES=10485760  # 单个日志文件最大字节数（默认10MB）